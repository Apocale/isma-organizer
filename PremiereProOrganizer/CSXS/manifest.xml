<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<ExtensionManifest xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" ExtensionBundleId="com.OrganizeFilesInProject" ExtensionBundleName="OrganizeFilesInProject" ExtensionBundleVersion="2.7.1" Version="7.0">
  <ExtensionList>
    <Extension Id="com.OrganizeFilesInProject.panel" Version="2.7.1" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="PPRO" Version="[0.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <!-- CEP 11 or later: Premiere Pro 2022, 2023 and 2024 ship CEP 11,
         2025 and later CEP 12. The schema number on the first line stays at
         7.0, the one Adobe's own samples declare for CEP 11 and 12 (it said
         12.0, a number CEP 11 is not documented to read). -->
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="11.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.OrganizeFilesInProject.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <!-- Node is REQUIRED. The Organize tab reads the auto-import folder
               and writes its run log; the B-roll tab (the former "Pinterest
               B-roll" panel, merged in 2.6.0) reads the downloads folder, draws
               thumbnails from local files and talks to Pinterest. This block
               was once emptied "because the panel uses no Node API" — then
               every Node feature failed silently in Premiere for weeks while
               the tests, which stub require(), stayed green.
               tests/check-panel.mjs fails if the script uses require() and this
               block does not enable it.
               The two last flags come from the B-roll panel: local video files
               must load into <video> and <canvas> for the thumbnails. -->
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
            <Parameter>--allow-file-access-from-files</Parameter>
            <Parameter>--disable-site-isolation-trials</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Isma Organizer</Menu>
          <Geometry>
            <Size>
              <Height>800</Height>
              <Width>400</Width>
            </Size>
            <MaxSize>
              <Height>1000</Height>
              <Width>1000</Width>
            </MaxSize>
            <MinSize>
              <Height>300</Height>
              <Width>300</Width>
            </MinSize>
          </Geometry>
          <Icons />
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
